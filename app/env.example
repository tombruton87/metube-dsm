# What the setup container writes to .env beside compose.yaml.
HTTP_PORT=8081
LAN_IP=192.168.1.20
TZ=Europe/London
APP_URL=http://192.168.1.20:8081
SSL_PROXY=0
HOST_UID=1027                          # the package's own user: MeTube runs as it, so downloads belong to it
HOST_GID=100
MT_IMAGE=ghcr.io/alexta69/metube:2026.10.19   # pinned; the window's Update moves it to a newer MeTube release
DL_DIR="/volume1/Downloads/MeTube"     # where downloads go (a folder in a shared folder; the share is never created)
DL_SRC="/volume1/Downloads/MeTube"     # …mounted at /downloads when it's there, else ./no-folder
DEF_KIND=video                         # video | audio — the Add tab's and the share page's default
DEF_QUALITY=best                       # best | 2160 | 1080 | 720 | 480
DEF_VFORMAT=mp4                        # mp4 (plays everywhere) | any (best available: WebM, MKV…)
DEF_AFORMAT=mp3                        # mp3 | m4a | opus
OUT_TPL=title                          # title | title_id | channel | date — a safe preset, never free text
OUTPUT_TEMPLATE="%(title)s.%(ext)s"
OUTPUT_TEMPLATE_PLAYLIST="%(playlist_title)s/%(title)s.%(ext)s"
SUB_MODE=off                           # off | download (.srt beside the video) | embed
SUB_LANGS=en                           # language codes joined by + (up to 5)
SUB_AUTO=0                             # 1: also automatic (generated) subtitles
EMBED_THUMB=1                          # cover art in MP4 and audio files
EMBED_META=1                           # title, artist, date… in the file
MT_MAX_DL=3                            # downloads at the same time, 1-5
MT_LAN=false                           # true: addresses on your own network may be downloaded from
YTDL_OPTS='{"windowsfilenames":true,"postprocessors":[{"key":"FFmpegMetadata"}]}'
YTDL_PRESETS='{"dsm-cover":{"writethumbnail":true,"postprocessors":[…]}}'
NOTIFY_DONE=0                          # 1: a DSM notification for every finished download
NOTIFY_FAIL=1                          # 1: a DSM notification when a download fails
CLEAN_DAYS=0                           # 0: off; N: files older than N days are removed from the download folder
